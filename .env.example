APP_URL=http://localhost

COUPON_V2_ADMIN_ENABLED=false
INVITATION_PUBLIC_ENABLED=false
COUPON_PUBLIC_ENABLED=false
SUBSCRIPTION_THREE_WEEK_UI_ENABLED=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
